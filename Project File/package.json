{
  "name": "keiyomi",
  "version": "3.2.0",
  "versionCode": 4,
  "description": "KeiYomi Desktop Manga & Document Reader",
  "main": "Script/main.js",
  "updateJson": "https://raw.githubusercontent.com/KeishaXD/KeiYomi/main/update.json",
  "homepage": "https://keishaxd.github.io/KeiYomi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeishaXD/KeiYomi.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check Script/main.js && node --check Script/preload.js && node --check UI/app-core.js && node --check UI/renderer.js && node --check UI/app-startup.js",
    "build": "npm run build:all",
    "build:local": "npm run build:win && npm run build:linux:portable",
    "build:win": "electron-builder --win --x64 --arm64 --publish never",
    "build:win:x64": "electron-builder --win --x64 --publish never",
    "build:win:arm64": "electron-builder --win --arm64 --publish never",
    "build:win:portable": "electron-builder --win portable --x64 --publish never",
    "build:win:portable:x64": "electron-builder --win portable --x64 --publish never",
    "build:win:portable:arm64": "electron-builder --win portable --arm64 --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:linux:portable": "electron-builder --linux tar.gz --publish never",
    "build:linux:tarxz": "electron-builder --linux tar.xz --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:all": "electron-builder --win --linux --mac --publish never"
  },
  "author": "KeishaXD",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "node-unrar-js": "^2.0.2"
  },
  "build": {
    "appId": "com.keishaxd.keiyomi",
    "productName": "KeiYomi",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "Script/**/*",
      "UI/**/*",
      "Lang/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json",
      "!node_modules/.cache",
      "!dist",
      "!.git",
      "!.github",
      "!*.md"
    ],
    "extraMetadata": {
      "versionCode": 4
    },
    "win": {
      "icon": "assets/logo.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": "nsis"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/logo.svg",
      "maintainer": "KeishaXD",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "nsis": {
      "include": "Script/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "buildUniversalInstaller": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
